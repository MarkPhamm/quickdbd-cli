{
  "name": "quickdbd",
  "displayName": "QuickDBD (qdbd)",
  "description": "QuickDBD and DBML schema files in VS Code: a sidebar with every schema, highlighting, live errors, outline, go to definition, the interactive ER diagram beside your editor, git diffs, dbt import, export and sharing. No terminal needed.",
  "version": "0.5.0",
  "publisher": "MarkPhamm",
  "author": "Minh (Mark) Pham",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "homepage": "https://qdbd.dev/vscode/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarkPhamm/quickdbd-cli",
    "directory": "vscode"
  },
  "bugs": "https://github.com/MarkPhamm/quickdbd-cli/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Linters"
  ],
  "keywords": [
    "quickdbd",
    "erd",
    "er diagram",
    "database",
    "schema",
    "dbml",
    "dbdiagram",
    "dbt",
    "mcp",
    "ai"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:plaintext",
    "workspaceContains:**/qdbd.layout.json",
    "onLanguage:dbml",
    "workspaceContains:**/*.dbml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs the qdbd CLI, which may come from the workspace's virtualenv."
    }
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "quickdbd",
        "label": "QuickDBD schemas"
      }
    ],
    "languages": [
      {
        "id": "quickdbd",
        "aliases": [
          "QuickDBD",
          "qdbd"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dbml",
        "aliases": [
          "DBML",
          "dbml"
        ],
        "extensions": [
          ".dbml"
        ],
        "configuration": "./language-configuration-dbml.json"
      }
    ],
    "grammars": [
      {
        "language": "quickdbd",
        "scopeName": "source.quickdbd",
        "path": "./syntaxes/quickdbd.tmLanguage.json"
      },
      {
        "language": "dbml",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "quickdbd.openPreview",
        "title": "Open Diagram to the Side",
        "category": "QuickDBD",
        "icon": "$(open-preview)"
      },
      {
        "command": "quickdbd.openInBrowser",
        "title": "Open in Browser",
        "category": "QuickDBD",
        "icon": "$(globe)"
      },
      {
        "command": "quickdbd.export",
        "title": "Export…",
        "category": "QuickDBD",
        "icon": "$(desktop-download)"
      },
      {
        "command": "quickdbd.exportPng",
        "title": "Export PNG",
        "category": "QuickDBD"
      },
      {
        "command": "quickdbd.exportSvg",
        "title": "Export SVG",
        "category": "QuickDBD"
      },
      {
        "command": "quickdbd.exportDrawio",
        "title": "Export draw.io",
        "category": "QuickDBD"
      },
      {
        "command": "quickdbd.exportHtml",
        "title": "Export HTML Page",
        "category": "QuickDBD"
      },
      {
        "command": "quickdbd.share",
        "title": "Share as a Gist Link",
        "category": "QuickDBD"
      },
      {
        "command": "quickdbd.compare",
        "title": "Compare with Git Ref…",
        "category": "QuickDBD",
        "icon": "$(git-compare)"
      },
      {
        "command": "quickdbd.importDbt",
        "title": "Import dbt Project…",
        "category": "QuickDBD",
        "icon": "$(database)"
      },
      {
        "command": "quickdbd.installCli",
        "title": "Install or Update qdbd",
        "category": "QuickDBD"
      },
      {
        "command": "quickdbd.newSchema",
        "title": "New Schema File…",
        "category": "QuickDBD",
        "icon": "$(new-file)"
      },
      {
        "command": "quickdbd.refreshSchemas",
        "title": "Refresh",
        "category": "QuickDBD",
        "icon": "$(refresh)"
      },
      {
        "command": "quickdbd.revealTable",
        "title": "Show in Diagram",
        "category": "QuickDBD",
        "icon": "$(open-preview)"
      },
      {
        "command": "quickdbd.convertToDbml",
        "title": "Convert to DBML",
        "category": "QuickDBD"
      },
      {
        "command": "quickdbd.convertToQuickdbd",
        "title": "Convert to QuickDBD Syntax",
        "category": "QuickDBD"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "quickdbd.openPreview",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/",
          "group": "navigation@1"
        },
        {
          "command": "quickdbd.compare",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "quickdbd.openPreview",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/"
        },
        {
          "command": "quickdbd.openInBrowser",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/"
        },
        {
          "command": "quickdbd.export",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/"
        },
        {
          "command": "quickdbd.exportPng",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/"
        },
        {
          "command": "quickdbd.exportSvg",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/"
        },
        {
          "command": "quickdbd.exportDrawio",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/"
        },
        {
          "command": "quickdbd.exportHtml",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/"
        },
        {
          "command": "quickdbd.share",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/"
        },
        {
          "command": "quickdbd.compare",
          "when": "editorLangId =~ /^(quickdbd|dbml)$/"
        },
        {
          "command": "quickdbd.convertToDbml",
          "when": "editorLangId == quickdbd"
        },
        {
          "command": "quickdbd.convertToQuickdbd",
          "when": "editorLangId == dbml"
        },
        {
          "command": "quickdbd.refreshSchemas",
          "when": "false"
        },
        {
          "command": "quickdbd.revealTable",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "quickdbd.newSchema",
          "when": "view == quickdbd.schemas",
          "group": "navigation@1"
        },
        {
          "command": "quickdbd.importDbt",
          "when": "view == quickdbd.schemas",
          "group": "navigation@2"
        },
        {
          "command": "quickdbd.refreshSchemas",
          "when": "view == quickdbd.schemas",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "quickdbd.openPreview",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "inline@1"
        },
        {
          "command": "quickdbd.compare",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "inline@2"
        },
        {
          "command": "quickdbd.revealTable",
          "when": "view == quickdbd.schemas && viewItem == table",
          "group": "inline"
        },
        {
          "command": "quickdbd.openPreview",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "1_open@1"
        },
        {
          "command": "quickdbd.openInBrowser",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "1_open@2"
        },
        {
          "command": "quickdbd.compare",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "1_open@3"
        },
        {
          "command": "quickdbd.exportPng",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "2_export@1"
        },
        {
          "command": "quickdbd.exportSvg",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "2_export@2"
        },
        {
          "command": "quickdbd.exportDrawio",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "2_export@3"
        },
        {
          "command": "quickdbd.exportHtml",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "2_export@4"
        },
        {
          "command": "quickdbd.share",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "3_share"
        },
        {
          "command": "quickdbd.convertToDbml",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "4_convert@1"
        },
        {
          "command": "quickdbd.convertToQuickdbd",
          "when": "view == quickdbd.schemas && viewItem == schema",
          "group": "4_convert@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "quickdbd.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == quickdbd"
      }
    ],
    "configuration": {
      "title": "QuickDBD",
      "properties": {
        "quickdbd.qdbdPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `qdbd` executable. Empty: the workspace's `.venv` (or `venv`), else the newer of the extension's own install (**QuickDBD: Install or Update qdbd**) and the one on `PATH`."
        },
        "quickdbd.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Open .txt files that look like QuickDBD or DBML schemas, or sit next to a qdbd layout file, as QuickDBD (or DBML)."
        },
        "quickdbd.strict": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Report QuickDBD-compatibility warnings as errors, like `qdbd check --strict`."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quickdbd",
          "title": "QuickDBD",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "quickdbd": [
        {
          "id": "quickdbd.schemas",
          "name": "Schemas",
          "icon": "media/activity.svg",
          "contextualTitle": "QuickDBD"
        },
        {
          "id": "quickdbd.actions",
          "name": "Actions",
          "icon": "media/activity.svg",
          "contextualTitle": "QuickDBD"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "quickdbd.schemas",
        "contents": "QuickDBD runs the qdbd CLI, which isn't installed yet.\n[Install qdbd](command:quickdbd.installCli)\nIt goes into a Python environment of the extension's own and takes about a minute.",
        "when": "quickdbd.cliMissing"
      },
      {
        "view": "quickdbd.schemas",
        "contents": "No QuickDBD schemas in this workspace yet.\n[New Schema File](command:quickdbd.newSchema)\n[Import dbt Project](command:quickdbd.importDbt)\nNew to QuickDBD? [Read the guide](https://qdbd.dev/vscode/).",
        "when": "!quickdbd.cliMissing && quickdbd.noSchemas"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts && npm run test:grammar",
    "test:grammar": "vscode-tmgrammar-test -g syntaxes/quickdbd.tmLanguage.json \"test/grammar/*.txt\" && vscode-tmgrammar-test -g syntaxes/dbml.tmLanguage.json \"test/grammar/*.dbml\"",
    "test:integration": "node esbuild.mjs && node test/integration/run.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "typescript": "5.9.3",
    "vscode-tmgrammar-test": "0.1.3"
  }
}
